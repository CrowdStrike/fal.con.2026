        "outcome": "case",
        "filter": "| #event.kind=\"alert\" #Vendor = octan #event.module = firewall\n\n// Correlate 3 security alerts occurring in sequence for the same user\n| correlate(\n    Alert1: {\n        #event.kind=\"alert\" rule.name=\"AV-DETECT-001\"\n    } include: [user.id, source.ip, destination.ip, rule.name, event.severity, event.category, @timestamp, @id],\n    \n    Alert2: {\n        #event.kind=\"alert\" rule.name=\"DLP-BLOCK-001\"\n    } include: [user.id, source.ip, destination.ip, rule.name, event.severity, event.category, @timestamp, @id],\n    \n    Alert3: {\n        #event.kind=\"alert\" rule.name=\"WAF-BLOCK-001\"\n    } include: [user.id, source.ip, destination.ip, rule.name, event.severity, event.category, @timestamp, @id],\n    // All 3 alerts must be for the same user\n    globalConstraints=user.id,\n    // All 3 alerts must occur within 10 minutes\n    within=10m,\n    // Enforce chronological order: Alert1 -> Alert2 -> Alert3\n    sequence=true\n)",
