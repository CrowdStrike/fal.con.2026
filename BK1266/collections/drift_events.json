{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Drift Event",
  "description": "Detected configuration drift event",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When drift was detected"
    },
    "policy_type": {
      "type": "string",
      "enum": ["prevention", "response", "firewall"],
      "description": "Type of policy that drifted"
    },
    "policy_id": {
      "type": "string",
      "description": "ID of the policy that changed"
    },
    "policy_name": {
      "type": "string",
      "description": "Name of the policy"
    },
    "drift_type": {
      "type": "string",
      "enum": ["added", "removed", "modified", "enabled", "disabled"],
      "description": "Type of drift detected"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Risk level of this drift"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Numerical risk score"
    },
    "changes": {
      "type": "object",
      "description": "Detailed changes detected",
      "properties": {
        "field": {
          "type": "string"
        },
        "old_value": {},
        "new_value": {}
      }
    },
    "baseline_snapshot_id": {
      "type": "string",
      "description": "Reference to baseline snapshot"
    },
    "current_snapshot_id": {
      "type": "string",
      "description": "Reference to current snapshot"
    },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "resolved", "suppressed"],
      "description": "Status of the drift event"
    },
    "remediation_available": {
      "type": "boolean",
      "description": "Whether automated remediation is available"
    },
    "remediation_action": {
      "type": "string",
      "description": "Recommended remediation action"
    }
  },
  "required": ["event_id", "detected_at", "policy_type", "drift_type", "risk_level"]
}
